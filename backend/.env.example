PORT=5000
NODE_ENV=development
JWT_SECRET=fyp_patient_app_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patient_app_db

# ============================================================
# AI PROVIDER ARCHITECTURE
# ============================================================
# Choose active AI provider: 'local' (default rule engine) | 'openai' | 'gemini'
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============================================================
# MAP & ROUTING PROVIDER ARCHITECTURE
# ============================================================
# Choose active providers:
# MAP_PROVIDER: 'maplibre' (default) | 'google'
# ROUTING_PROVIDER: 'openrouteservice' (default) | 'geoapify' | 'google'
# PLACES_PROVIDER: 'geoapify' (default) | 'google'
MAP_PROVIDER=maplibre
ROUTING_PROVIDER=openrouteservice
PLACES_PROVIDER=geoapify

# Open Providers (Free Tiers available at geoapify.com & openrouteservice.org)
GEOAPIFY_API_KEY=
OPENROUTESERVICE_API_KEY=

# ============================================================
# GOOGLE MAPS PLATFORM (PRESERVED FOR FUTURE USE)
# ============================================================
# Retained for future enterprise production billing switch
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Twilio Verify (Phone OTP) & Twilio Messaging (SMS Booking Confirmation)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Resend Transactional Email (Email OTP & Booking Confirmation)
RESEND_API_KEY=
EMAIL_FROM=MedLink Health <onboarding@resend.dev>

FRONTEND_URL=*
NLP_SERVICE_URL=http://localhost:8000
PHARMACY_SECURITY_SERVICE_URL=http://localhost:4000
