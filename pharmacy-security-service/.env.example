# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT & Security Configuration
JWT_SECRET=your-secure-jwt-secret-placeholder
JWT_EXPIRES_IN=1d

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmacy_security_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# External Integration Service Boundaries (Teammate Services)
NOTIFICATION_SERVICE_URL=http://localhost:5000/api/notifications
CLINIC_LOCATION_SERVICE_URL=http://localhost:6000/api/clinics
NLP_FORECASTING_SERVICE_URL=http://localhost:8000
